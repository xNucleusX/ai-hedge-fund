# Copy to .env.local for `next dev`, or set these as Vercel Project ->
# Settings -> Environment Variables before deploying.

# Required for any ticker outside the free set (AAPL, GOOGL, MSFT, NVDA, TSLA).
# Get one at https://financialdatasets.ai
FINANCIAL_DATASETS_API_KEY=

# Required for the LLM investor agents (Buffett, Munger, Graham, Lynch,
# Druckenmiller). The quant model (PEAD) doesn't need this.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
